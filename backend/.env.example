# SQLite for local dev. For Neon: postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
DATABASE_URL=sqlite:///./visibility.db
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://localhost:3010
FRONTEND_URL=http://localhost:3010

# Engines: "auto" uses real engines when a key is set, else mock. "mock" forces mock for all.
ENGINE_MODE=auto
OPENAI_API_KEY=
SERPAPI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low


# Spend protection
MAX_CONCURRENT_CALLS=8
MAX_CALLS_PER_ENGINE=4
DAILY_ANSWER_LIMIT=500
MAX_ACTIVE_ANSWERS=300
SCAN_STARTS_PER_MINUTE=6

# Email (empty SMTP_HOST = emails are only logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Lumen <no-reply@yourdomain.com>

# Optional: LLM sentiment scoring and error monitoring
ANTHROPIC_API_KEY=
PARSER_MODEL=claude-haiku-5-5
DRAFT_MODEL=claude-sonnet-5-5
DAILY_DRAFT_LIMIT=30
SENTRY_DSN=
